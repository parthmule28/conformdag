  },
  "additionalProperties": false,
  "properties": {
    "audit_evidence": {
      "items": {
        "$ref": "#/$defs/SemanticAuditEvidence"
      },
      "title": "Audit Evidence",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "evidence": {
      "title": "Evidence",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "remediation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remediation"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW",
        "NOT_APPLICABLE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "evidence",
    "explanation",
    "confidence"
  ],
  "title": "SemanticResponse",
  "type": "object"
}
