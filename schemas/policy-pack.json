{
  "$defs": {
    "AirflowProfile": {
      "enum": [
        "3.3.0"
      ],
      "title": "AirflowProfile",
      "type": "string"
    },
    "AlwaysBlockRule": {
      "additionalProperties": false,
      "description": "Rule: the listed policy ids always block, even when otherwise gated out.",
      "properties": {
        "policy_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Ids",
          "type": "array"
        },
        "type": {
          "const": "always-block",
          "default": "always-block",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "policy_ids"
      ],
      "title": "AlwaysBlockRule",
      "type": "object"
    },
    "ApprovedAbstractionsConfig": {
      "additionalProperties": false,
      "properties": {
        "abstractions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Abstractions",
          "type": "object"
        },
        "kind": {
          "const": "approved-abstractions",
          "default": "approved-abstractions",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ApprovedAbstractionsConfig",
      "type": "object"
    },
    "CatchupPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_catchup": {
          "default": false,
          "title": "Allow Catchup",
          "type": "boolean"
        },
        "kind": {
          "const": "catchup-policy",
          "default": "catchup-policy",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CatchupPolicyConfig",
      "type": "object"
    },
    "DynamicDagFactoryConfig": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": false,
          "title": "Allow",
          "type": "boolean"
        },
        "kind": {
          "const": "dynamic-dag-factory",
          "default": "dynamic-dag-factory",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "DynamicDagFactoryConfig",
      "type": "object"
    },
    "EnforcementConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_abstention": {
          "default": true,
          "title": "Allow Abstention",
          "type": "boolean"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "deterministic_checks": {
          "items": {
            "type": "string"
          },
          "title": "Deterministic Checks",
          "type": "array"
        },
        "model_check": {
          "default": false,
          "title": "Model Check",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/EnforcementType"
        }
      },
      "required": [
        "type"
      ],
      "title": "EnforcementConfig",
      "type": "object"
    },
    "EnforcementType": {
      "enum": [
        "deterministic",
        "semantic",
        "hybrid"
      ],
      "title": "EnforcementType",
      "type": "string"
    },
    "ExceptionPolicy": {
      "additionalProperties": false,
      "properties": {
        "require_expiry": {
          "default": true,
          "title": "Require Expiry",
          "type": "boolean"
        },
        "require_reason": {
          "default": true,
          "title": "Require Reason",
          "type": "boolean"
        }
      },
      "title": "ExceptionPolicy",
      "type": "object"
    },
    "ExecutionTimeoutConfig": {
      "additionalProperties": false,
      "properties": {
        "approved_default_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Default Seconds"
        },
        "kind": {
          "const": "execution-timeout",
          "default": "execution-timeout",
          "title": "Kind",
          "type": "string"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "min_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Seconds"
        }
      },
      "title": "ExecutionTimeoutConfig",
      "type": "object"
    },
    "FailureRateRule": {
      "additionalProperties": false,
      "description": "Rule: failing findings below ``max_percent`` percent of all findings.",
      "properties": {
        "max_percent": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Max Percent",
          "type": "number"
        },
        "type": {
          "const": "failure-rate",
          "default": "failure-rate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "max_percent"
      ],
      "title": "FailureRateRule",
      "type": "object"
    },
    "ForbiddenOperatorsConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "forbidden-operators",
          "default": "forbidden-operators",
          "title": "Kind",
          "type": "string"
        },
        "operators": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/OperatorRule"
              }
            ]
          },
          "title": "Operators",
          "type": "object"
        }
      },
      "title": "ForbiddenOperatorsConfig",
      "type": "object"
    },
    "IdempotenceConfig": {
      "additionalProperties": false,
      "properties": {
        "external_write_markers": {
          "items": {
            "type": "string"
          },
          "title": "External Write Markers",
          "type": "array"
        },
        "kind": {
          "const": "idempotence",
          "default": "idempotence",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "IdempotenceConfig",
      "type": "object"
    },
    "LifecycleStatus": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "ACTIVE",
        "CONFLICTED",
        "DEPRECATED",
        "REJECTED"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "MaxFindingsRule": {
      "additionalProperties": false,
      "description": "Rule: fewer than ``count`` failing findings (a report with none always passes).",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "type": {
          "const": "max-findings",
          "default": "max-findings",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "count"
      ],
      "title": "MaxFindingsRule",
      "type": "object"
    },
    "MaxSeverityRule": {
      "additionalProperties": false,
      "description": "Rule: no failing findings at or above the given severity.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "type": {
          "const": "max-severity",
          "default": "max-severity",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "severity"
      ],
      "title": "MaxSeverityRule",
      "type": "object"
    },
    "ModuleScopeVariablesConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "module-scope-variables",
          "default": "module-scope-variables",
          "title": "Kind",
          "type": "string"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        }
      },
      "title": "ModuleScopeVariablesConfig",
      "type": "object"
    },
    "NoNewFindingsRule": {
      "additionalProperties": false,
      "description": "Rule: no failing findings that are absent from the baseline scan.",
      "properties": {
        "type": {
          "const": "no-new-findings",
          "default": "no-new-findings",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "NoNewFindingsRule",
      "type": "object"
    },
    "OperatorRule": {
      "additionalProperties": false,
      "properties": {
        "airflow_profiles": {
          "items": {
            "$ref": "#/$defs/AirflowProfile"
          },
          "title": "Airflow Profiles",
          "type": "array"
        },
        "max_airflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Airflow Version"
        },
        "min_airflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Airflow Version"
        },
        "replacement": {
          "title": "Replacement",
          "type": "string"
        }
      },
      "required": [
        "replacement"
      ],
      "title": "OperatorRule",
      "type": "object"
    },
    "OrchestrationBoundaryConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "orchestration-boundary",
          "default": "orchestration-boundary",
          "title": "Kind",
          "type": "string"
        },
        "max_complexity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Complexity"
        },
        "max_statements": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Statements"
        },
        "signal_patterns": {
          "items": {
            "type": "string"
          },
          "title": "Signal Patterns",
          "type": "array"
        }
      },
      "title": "OrchestrationBoundaryConfig",
      "type": "object"
    },
    "Ownership": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approvers": {
          "items": {
            "type": "string"
          },
          "title": "Approvers",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "review_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Before"
        }
      },
      "required": [
        "owner"
      ],
      "title": "Ownership",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "airflow_profiles": {
          "items": {
            "$ref": "#/$defs/AirflowProfile"
          },
          "title": "Airflow Profiles",
          "type": "array"
        },
        "configuration": {
          "discriminator": {
            "mapping": {
              "approved-abstractions": "#/$defs/ApprovedAbstractionsConfig",
              "catchup-policy": "#/$defs/CatchupPolicyConfig",
              "dynamic-dag-factory": "#/$defs/DynamicDagFactoryConfig",
              "execution-timeout": "#/$defs/ExecutionTimeoutConfig",
              "forbidden-operators": "#/$defs/ForbiddenOperatorsConfig",
              "idempotence": "#/$defs/IdempotenceConfig",
              "module-scope-variables": "#/$defs/ModuleScopeVariablesConfig",
              "orchestration-boundary": "#/$defs/OrchestrationBoundaryConfig",
              "required-owner": "#/$defs/RequiredOwnerConfig",
              "required-tags": "#/$defs/RequiredTagsConfig",
              "retry-bounds": "#/$defs/RetryBoundsConfig",
              "ruff-air": "#/$defs/RuffAirConfig",
              "sensitive-logging": "#/$defs/SensitiveLoggingConfig",
              "start-date-freshness": "#/$defs/StartDateFreshnessConfig",
              "top-level-io": "#/$defs/TopLevelIOConfig"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RequiredOwnerConfig"
            },
            {
              "$ref": "#/$defs/RequiredTagsConfig"
            },
            {
              "$ref": "#/$defs/ExecutionTimeoutConfig"
            },
            {
              "$ref": "#/$defs/RetryBoundsConfig"
            },
            {
              "$ref": "#/$defs/TopLevelIOConfig"
            },
            {
              "$ref": "#/$defs/ForbiddenOperatorsConfig"
            },
            {
              "$ref": "#/$defs/IdempotenceConfig"
            },
            {
              "$ref": "#/$defs/OrchestrationBoundaryConfig"
            },
            {
              "$ref": "#/$defs/SensitiveLoggingConfig"
            },
            {
              "$ref": "#/$defs/ApprovedAbstractionsConfig"
            },
            {
              "$ref": "#/$defs/StartDateFreshnessConfig"
            },
            {
              "$ref": "#/$defs/CatchupPolicyConfig"
            },
            {
              "$ref": "#/$defs/ModuleScopeVariablesConfig"
            },
            {
              "$ref": "#/$defs/DynamicDagFactoryConfig"
            },
            {
              "$ref": "#/$defs/RuffAirConfig"
            }
          ],
          "title": "Configuration"
        },
        "enforcement": {
          "$ref": "#/$defs/EnforcementConfig"
        },
        "exceptions": {
          "$ref": "#/$defs/ExceptionPolicy"
        },
        "id": {
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "title": "Id",
          "type": "string"
        },
        "invariant": {
          "title": "Invariant",
          "type": "string"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "safe_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Path"
        },
        "scope": {
          "$ref": "#/$defs/PolicyScope"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/PolicySource"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "status",
        "severity",
        "ownership",
        "source",
        "invariant",
        "enforcement",
        "configuration"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PolicyScope": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "operators": {
          "items": {
            "type": "string"
          },
          "title": "Operators",
          "type": "array"
        }
      },
      "title": "PolicyScope",
      "type": "object"
    },
    "PolicySource": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "document": {
          "format": "path",
          "title": "Document",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "document",
        "section",
        "content_hash"
      ],
      "title": "PolicySource",
      "type": "object"
    },
    "QualityGate": {
      "additionalProperties": false,
      "description": "One org-defined pass/fail decision over a scan's findings.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "rules": {
          "items": {
            "discriminator": {
              "mapping": {
                "always-block": "#/$defs/AlwaysBlockRule",
                "failure-rate": "#/$defs/FailureRateRule",
                "max-findings": "#/$defs/MaxFindingsRule",
                "max-severity": "#/$defs/MaxSeverityRule",
                "no-new-findings": "#/$defs/NoNewFindingsRule"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NoNewFindingsRule"
              },
              {
                "$ref": "#/$defs/MaxSeverityRule"
              },
              {
                "$ref": "#/$defs/MaxFindingsRule"
              },
              {
                "$ref": "#/$defs/AlwaysBlockRule"
              },
              {
                "$ref": "#/$defs/FailureRateRule"
              }
            ]
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rules"
      ],
      "title": "QualityGate",
      "type": "object"
    },
    "RequiredOwnerConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Pattern"
        },
        "allowed_values": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "kind": {
          "const": "required-owner",
          "default": "required-owner",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RequiredOwnerConfig",
      "type": "object"
    },
    "RequiredTagsConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Allowed Values",
          "type": "object"
        },
        "kind": {
          "const": "required-tags",
          "default": "required-tags",
          "title": "Kind",
          "type": "string"
        },
        "required_keys": {
          "items": {
            "type": "string"
          },
          "title": "Required Keys",
          "type": "array"
        }
      },
      "title": "RequiredTagsConfig",
      "type": "object"
    },
    "RetryBoundsConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_zero_retries": {
          "default": true,
          "title": "Allow Zero Retries",
          "type": "boolean"
        },
        "kind": {
          "const": "retry-bounds",
          "default": "retry-bounds",
          "title": "Kind",
          "type": "string"
        },
        "max_delay_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Delay Seconds"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "min_delay_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Min Delay Seconds",
          "type": "integer"
        },
        "min_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Min Retries",
          "type": "integer"
        }
      },
      "required": [
        "max_retries"
      ],
      "title": "RetryBoundsConfig",
      "type": "object"
    },
    "RuffAirConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ruff-air",
          "default": "ruff-air",
          "title": "Kind",
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "RuffAirConfig",
      "type": "object"
    },
    "SensitiveLoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sensitive-logging",
          "default": "sensitive-logging",
          "title": "Kind",
          "type": "string"
        },
        "logging_calls": {
          "items": {
            "type": "string"
          },
          "title": "Logging Calls",
          "type": "array"
        },
        "secret_patterns": {
          "items": {
            "type": "string"
          },
          "title": "Secret Patterns",
          "type": "array"
        }
      },
      "title": "SensitiveLoggingConfig",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StartDateFreshnessConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "start-date-freshness",
          "default": "start-date-freshness",
          "title": "Kind",
          "type": "string"
        },
        "max_age_years": {
          "default": 2,
          "minimum": 1,
          "title": "Max Age Years",
          "type": "integer"
        },
        "require_timezone": {
          "default": true,
          "title": "Require Timezone",
          "type": "boolean"
        }
      },
      "title": "StartDateFreshnessConfig",
      "type": "object"
    },
    "TopLevelIOConfig": {
      "additionalProperties": false,
      "properties": {
        "forbidden_calls": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Calls",
          "type": "array"
        },
        "kind": {
          "const": "top-level-io",
          "default": "top-level-io",
          "title": "Kind",
          "type": "string"
        },
        "uncertain_as_review": {
          "default": true,
          "title": "Uncertain As Review",
          "type": "boolean"
        }
      },
      "title": "TopLevelIOConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/Policy"
      },
      "title": "Policies",
      "type": "array"
    },
    "quality_gates": {
      "items": {
        "$ref": "#/$defs/QualityGate"
      },
