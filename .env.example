# Copy to .env and fill in values. Never commit .env.
#
# Required for --semantic scans (BYOK). Get a key from https://openrouter.ai/keys
CONFORMDAG_MODEL_API_KEY=

# Optional overrides used by mise run scan:semantic-example
CONFORMDAG_SEMANTIC_BASE_URL=https://openrouter.ai/api/v1
CONFORMDAG_SEMANTIC_MODEL=deepseek/deepseek-v4-flash
